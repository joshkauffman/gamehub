{
  "questions": [
    { "id": "hsp-g1-01", "grade": 1, "strand": "operations", "topic": "addition", "difficulty": 1, "prompt": "5 + 3 = ?", "choices": ["7", "8", "9", "6"], "answerIndex": 1, "explanation": "Start at 5 and count up 3 more: 6, 7, 8." },
    { "id": "hsp-g1-02", "grade": 1, "strand": "operations", "topic": "subtraction", "difficulty": 1, "prompt": "9 − 4 = ?", "choices": ["4", "5", "6", "3"], "answerIndex": 1, "explanation": "Start at 9 and count back 4: 8, 7, 6, 5." },
    { "id": "hsp-g1-03", "grade": 1, "strand": "number-sense", "topic": "counting", "difficulty": 1, "prompt": "What number comes right after 13?", "choices": ["12", "14", "15", "13"], "answerIndex": 1, "explanation": "Counting up from 13, the next number is 14." },
    { "id": "hsp-g1-04", "grade": 1, "strand": "number-sense", "topic": "counting", "difficulty": 1, "prompt": "What number comes right before 10?", "choices": ["8", "9", "11", "10"], "answerIndex": 1, "explanation": "Counting down from 10, the number right before it is 9." },
    { "id": "hsp-g1-05", "grade": 1, "strand": "number-sense", "topic": "comparing-numbers", "difficulty": 1, "prompt": "Which number is bigger: 12 or 21?", "choices": ["12", "21", "They are equal", "Cannot tell"], "answerIndex": 1, "explanation": "21 has a 2 in the tens place and 12 has a 1, so 21 is bigger." },
    { "id": "hsp-g1-06", "grade": 1, "strand": "geometry-measurement", "topic": "shapes", "difficulty": 1, "prompt": "A shape with 3 sides and 3 corners is called a...", "choices": ["Square", "Triangle", "Circle", "Rectangle"], "answerIndex": 1, "explanation": "A triangle always has exactly 3 sides and 3 corners." },
    { "id": "hsp-g1-07", "grade": 1, "strand": "geometry-measurement", "topic": "shapes", "difficulty": 1, "prompt": "A shape with 4 equal sides and 4 corners that are all perfect corners (like a picture frame) is called a...", "choices": ["Rectangle", "Triangle", "Square", "Circle"], "answerIndex": 2, "explanation": "A square has 4 equal sides and 4 right-angle corners." },
    { "id": "hsp-g1-08", "grade": 1, "strand": "number-sense", "topic": "skip-counting", "difficulty": 1, "prompt": "2, 4, 6, 8, __?", "choices": ["9", "10", "12", "11"], "answerIndex": 1, "explanation": "Counting by 2s, the next number after 8 is 10." },
    { "id": "hsp-g1-09", "grade": 1, "strand": "operations", "topic": "addition", "difficulty": 1, "prompt": "Mia has 4 apples. Her friend gives her 5 more. How many apples does Mia have now?", "choices": ["8", "9", "10", "7"], "answerIndex": 1, "explanation": "4 + 5 = 9 apples." },
    { "id": "hsp-g1-10", "grade": 1, "strand": "operations", "topic": "subtraction", "difficulty": 1, "prompt": "There are 10 birds on a branch. 3 fly away. How many birds are left?", "choices": ["6", "7", "8", "5"], "answerIndex": 1, "explanation": "10 − 3 = 7 birds." },
    { "id": "hsp-g1-11", "grade": 1, "strand": "number-sense", "topic": "even-odd", "difficulty": 1, "prompt": "Which of these numbers is an even number?", "choices": ["7", "10", "13", "15"], "answerIndex": 1, "explanation": "10 can be split into two equal groups of 5, so it's even." },
    { "id": "hsp-g1-12", "grade": 1, "strand": "number-sense", "topic": "comparing-numbers", "difficulty": 1, "prompt": "6 is ___ 9.", "choices": ["less than", "greater than", "equal to", "none of these"], "answerIndex": 0, "explanation": "6 comes before 9 when counting up, so 6 is less than 9." },

    { "id": "hsp-g2-01", "grade": 2, "strand": "operations", "topic": "addition", "difficulty": 1, "prompt": "36 + 27 = ?", "choices": ["62", "63", "64", "53"], "answerIndex": 1, "explanation": "36 + 27 = 63." },
    { "id": "hsp-g2-02", "grade": 2, "strand": "operations", "topic": "subtraction", "difficulty": 1, "prompt": "82 − 45 = ?", "choices": ["37", "47", "36", "27"], "answerIndex": 0, "explanation": "82 − 45 = 37." },
    { "id": "hsp-g2-03", "grade": 2, "strand": "number-sense", "topic": "place-value", "difficulty": 1, "prompt": "In the number 758, what digit is in the tens place?", "choices": ["7", "5", "8", "0"], "answerIndex": 1, "explanation": "In 758, the 7 is hundreds, the 5 is tens, and the 8 is ones." },
    { "id": "hsp-g2-04", "grade": 2, "strand": "number-sense", "topic": "skip-counting", "difficulty": 1, "prompt": "5, 10, 15, 20, __?", "choices": ["22", "24", "25", "30"], "answerIndex": 2, "explanation": "Counting by 5s, the next number after 20 is 25." },
    { "id": "hsp-g2-05", "grade": 2, "strand": "data-ratios", "topic": "money-time", "difficulty": 2, "prompt": "You have 3 dimes and 2 pennies. A dime is worth 10 cents. How many cents do you have in total?", "choices": ["23", "32", "30", "35"], "answerIndex": 1, "explanation": "3 dimes = 30 cents, plus 2 pennies = 32 cents." },
    { "id": "hsp-g2-06", "grade": 2, "strand": "data-ratios", "topic": "money-time", "difficulty": 1, "prompt": "A clock shows 3:00. What time will it be in 1 hour?", "choices": ["2:00", "3:00", "4:00", "5:00"], "answerIndex": 2, "explanation": "One hour after 3:00 is 4:00." },
    { "id": "hsp-g2-07", "grade": 2, "strand": "operations", "topic": "addition", "difficulty": 2, "prompt": "A farmer has 45 chickens and buys 18 more. How many chickens does he have now?", "choices": ["63", "53", "68", "61"], "answerIndex": 0, "explanation": "45 + 18 = 63 chickens." },
    { "id": "hsp-g2-08", "grade": 2, "strand": "number-sense", "topic": "comparing-numbers", "difficulty": 1, "prompt": "Which number is smaller: 59 or 95?", "choices": ["59", "95", "They are equal", "Cannot tell"], "answerIndex": 0, "explanation": "59 has a 5 in the tens place while 95 has a 9, so 59 is smaller." },
    { "id": "hsp-g2-09", "grade": 2, "strand": "number-sense", "topic": "place-value", "difficulty": 1, "prompt": "What number has 4 tens and 7 ones?", "choices": ["74", "47", "470", "40"], "answerIndex": 1, "explanation": "4 tens is 40, plus 7 ones is 47." },
    { "id": "hsp-g2-10", "grade": 2, "strand": "operations", "topic": "subtraction", "difficulty": 2, "prompt": "There were 72 crayons in a box. 29 were used. How many are left?", "choices": ["43", "53", "42", "33"], "answerIndex": 0, "explanation": "72 − 29 = 43 crayons." },
    { "id": "hsp-g2-11", "grade": 2, "strand": "number-sense", "topic": "even-odd", "difficulty": 1, "prompt": "Which of these numbers is odd?", "choices": ["24", "31", "40", "58"], "answerIndex": 1, "explanation": "31 cannot be split into two equal groups, so it's odd." },
    { "id": "hsp-g2-12", "grade": 2, "strand": "number-sense", "topic": "skip-counting", "difficulty": 1, "prompt": "100, 90, 80, __?", "choices": ["75", "70", "60", "65"], "answerIndex": 1, "explanation": "Counting down by 10s, the next number after 80 is 70." },

    { "id": "hsp-g3-01", "grade": 3, "strand": "operations", "topic": "multiplication", "difficulty": 1, "prompt": "6 × 7 = ?", "choices": ["42", "36", "48", "49"], "answerIndex": 0, "explanation": "6 × 7 = 42." },
    { "id": "hsp-g3-02", "grade": 3, "strand": "operations", "topic": "division", "difficulty": 1, "prompt": "36 ÷ 4 = ?", "choices": ["8", "9", "7", "6"], "answerIndex": 1, "explanation": "4 × 9 = 36, so 36 ÷ 4 = 9." },
    { "id": "hsp-g3-03", "grade": 3, "strand": "fractions-decimals", "topic": "fractions", "difficulty": 1, "prompt": "Which fraction means one half?", "choices": ["1/2", "1/3", "2/1", "1/4"], "answerIndex": 0, "explanation": "One half is written as 1/2 — one part out of two equal parts." },
    { "id": "hsp-g3-04", "grade": 3, "strand": "fractions-decimals", "topic": "fractions", "difficulty": 2, "prompt": "Which is bigger: 1/2 or 1/4?", "choices": ["1/2", "1/4", "They are equal", "Cannot tell"], "answerIndex": 0, "explanation": "If you split something into 2 equal parts vs. 4 equal parts, each of the 2 parts is bigger." },
    { "id": "hsp-g3-05", "grade": 3, "strand": "geometry-measurement", "topic": "perimeter-area", "difficulty": 2, "prompt": "A rectangle is 5 cm long and 3 cm wide. What is its perimeter (the distance all the way around)?", "choices": ["15 cm", "16 cm", "8 cm", "30 cm"], "answerIndex": 1, "explanation": "Perimeter = 5 + 3 + 5 + 3 = 16 cm." },
    { "id": "hsp-g3-06", "grade": 3, "strand": "geometry-measurement", "topic": "perimeter-area", "difficulty": 2, "prompt": "A rectangle is 4 cm long and 3 cm wide. What is its area?", "choices": ["7 cm²", "12 cm²", "14 cm²", "24 cm²"], "answerIndex": 1, "explanation": "Area = length × width = 4 × 3 = 12 cm²." },
    { "id": "hsp-g3-07", "grade": 3, "strand": "number-sense", "topic": "rounding", "difficulty": 2, "prompt": "Round 47 to the nearest ten.", "choices": ["40", "45", "50", "55"], "answerIndex": 2, "explanation": "47 is closer to 50 than to 40." },
    { "id": "hsp-g3-08", "grade": 3, "strand": "number-sense", "topic": "rounding", "difficulty": 2, "prompt": "Round 82 to the nearest ten.", "choices": ["80", "85", "90", "75"], "answerIndex": 0, "explanation": "82 is closer to 80 than to 90." },
    { "id": "hsp-g3-09", "grade": 3, "strand": "operations", "topic": "multiplication", "difficulty": 2, "prompt": "Each box has 8 pencils. How many pencils are in 5 boxes?", "choices": ["35", "40", "45", "48"], "answerIndex": 1, "explanation": "8 × 5 = 40 pencils." },
    { "id": "hsp-g3-10", "grade": 3, "strand": "operations", "topic": "division", "difficulty": 2, "prompt": "24 cookies are shared equally among 6 friends. How many cookies does each friend get?", "choices": ["3", "4", "5", "6"], "answerIndex": 1, "explanation": "24 ÷ 6 = 4 cookies each." },
    { "id": "hsp-g3-11", "grade": 3, "strand": "operations", "topic": "multiplication", "difficulty": 1, "prompt": "9 × 3 = ?", "choices": ["24", "27", "29", "18"], "answerIndex": 1, "explanation": "9 × 3 = 27." },
    { "id": "hsp-g3-12", "grade": 3, "strand": "fractions-decimals", "topic": "fractions", "difficulty": 2, "prompt": "A pizza is cut into 8 equal slices. If you eat 3 slices, what fraction of the pizza did you eat?", "choices": ["3/8", "3/5", "5/8", "8/3"], "answerIndex": 0, "explanation": "You ate 3 out of the 8 equal slices, which is written 3/8." },

    { "id": "hsp-g4-01", "grade": 4, "strand": "operations", "topic": "multiplication", "difficulty": 2, "prompt": "23 × 4 = ?", "choices": ["86", "92", "88", "96"], "answerIndex": 1, "explanation": "23 × 4 = 92." },
    { "id": "hsp-g4-02", "grade": 4, "strand": "operations", "topic": "division", "difficulty": 2, "prompt": "144 ÷ 12 = ?", "choices": ["11", "12", "14", "10"], "answerIndex": 1, "explanation": "12 × 12 = 144, so 144 ÷ 12 = 12." },
    { "id": "hsp-g4-03", "grade": 4, "strand": "fractions-decimals", "topic": "equivalent-fractions", "difficulty": 2, "prompt": "Which fraction is equivalent to 1/2?", "choices": ["2/4", "1/3", "3/5", "2/3"], "answerIndex": 0, "explanation": "2/4 simplifies to 1/2, since 2 and 4 can both be divided by 2." },
    { "id": "hsp-g4-04", "grade": 4, "strand": "fractions-decimals", "topic": "fractions", "difficulty": 2, "prompt": "Which is bigger: 3/4 or 2/3?", "choices": ["3/4", "2/3", "They are equal", "Cannot tell"], "answerIndex": 0, "explanation": "3/4 = 0.75 and 2/3 ≈ 0.67, so 3/4 is bigger." },
    { "id": "hsp-g4-05", "grade": 4, "strand": "fractions-decimals", "topic": "decimals", "difficulty": 2, "prompt": "Which decimal is the same as 1/2?", "choices": ["0.2", "0.5", "0.05", "5.0"], "answerIndex": 1, "explanation": "1 divided by 2 is 0.5." },
    { "id": "hsp-g4-06", "grade": 4, "strand": "fractions-decimals", "topic": "decimals", "difficulty": 2, "prompt": "Which is bigger: 0.7 or 0.65?", "choices": ["0.7", "0.65", "They are equal", "Cannot tell"], "answerIndex": 0, "explanation": "0.7 is the same as 0.70, and 70 is more than 65." },
    { "id": "hsp-g4-07", "grade": 4, "strand": "number-sense", "topic": "factors-multiples", "difficulty": 2, "prompt": "Which of these numbers is a factor of 12?", "choices": ["5", "4", "7", "9"], "answerIndex": 1, "explanation": "4 × 3 = 12, so 4 is a factor of 12." },
    { "id": "hsp-g4-08", "grade": 4, "strand": "number-sense", "topic": "factors-multiples", "difficulty": 2, "prompt": "Which of these numbers is a multiple of 6?", "choices": ["16", "18", "20", "22"], "answerIndex": 1, "explanation": "6 × 3 = 18, so 18 is a multiple of 6." },
    { "id": "hsp-g4-09", "grade": 4, "strand": "operations", "topic": "multiplication", "difficulty": 3, "prompt": "A theater has 24 rows with 15 seats each. How many seats are there in total?", "choices": ["320", "360", "340", "300"], "answerIndex": 1, "explanation": "24 × 15 = 360 seats." },
    { "id": "hsp-g4-10", "grade": 4, "strand": "operations", "topic": "division", "difficulty": 3, "prompt": "A school orders 156 pencils to share equally among 12 classrooms. How many pencils does each classroom get?", "choices": ["12", "13", "14", "11"], "answerIndex": 1, "explanation": "156 ÷ 12 = 13 pencils each." },
    { "id": "hsp-g4-11", "grade": 4, "strand": "number-sense", "topic": "rounding", "difficulty": 2, "prompt": "Round 3.6 to the nearest whole number.", "choices": ["3", "4", "3.5", "5"], "answerIndex": 1, "explanation": "3.6 is closer to 4 than to 3." },
    { "id": "hsp-g4-12", "grade": 4, "strand": "fractions-decimals", "topic": "fraction-operations", "difficulty": 2, "prompt": "What is 1/4 + 1/4?", "choices": ["1/2", "1/4", "3/4", "2/8"], "answerIndex": 0, "explanation": "1/4 + 1/4 = 2/4, which simplifies to 1/2." },

    { "id": "hsp-g5-01", "grade": 5, "strand": "fractions-decimals", "topic": "fraction-operations", "difficulty": 3, "prompt": "1/3 + 1/6 = ?", "choices": ["1/2", "1/3", "2/9", "1/9"], "answerIndex": 0, "explanation": "1/3 = 2/6, so 2/6 + 1/6 = 3/6, which simplifies to 1/2." },
    { "id": "hsp-g5-02", "grade": 5, "strand": "fractions-decimals", "topic": "fraction-operations", "difficulty": 3, "prompt": "1/2 × 2/3 = ?", "choices": ["1/3", "1/6", "2/3", "3/4"], "answerIndex": 0, "explanation": "Multiply the tops and bottoms: (1×2)/(2×3) = 2/6, which simplifies to 1/3." },
    { "id": "hsp-g5-03", "grade": 5, "strand": "fractions-decimals", "topic": "decimal-operations", "difficulty": 2, "prompt": "2.75 + 1.5 = ?", "choices": ["4.25", "3.25", "4.5", "3.75"], "answerIndex": 0, "explanation": "2.75 + 1.50 = 4.25." },
    { "id": "hsp-g5-04", "grade": 5, "strand": "fractions-decimals", "topic": "decimal-operations", "difficulty": 2, "prompt": "5.2 − 3.65 = ?", "choices": ["1.55", "1.65", "2.55", "1.45"], "answerIndex": 0, "explanation": "5.20 − 3.65 = 1.55." },
    { "id": "hsp-g5-05", "grade": 5, "strand": "geometry-measurement", "topic": "volume", "difficulty": 3, "prompt": "A box is 3 cm long, 2 cm wide, and 4 cm tall. What is its volume?", "choices": ["9 cm³", "24 cm³", "20 cm³", "18 cm³"], "answerIndex": 1, "explanation": "Volume = length × width × height = 3 × 2 × 4 = 24 cm³." },
    { "id": "hsp-g5-06", "grade": 5, "strand": "operations", "topic": "order-of-operations", "difficulty": 2, "prompt": "What is 3 + 4 × 2?", "choices": ["11", "14", "10", "8"], "answerIndex": 0, "explanation": "Multiply first: 4 × 2 = 8, then add 3: 3 + 8 = 11." },
    { "id": "hsp-g5-07", "grade": 5, "strand": "operations", "topic": "order-of-operations", "difficulty": 2, "prompt": "What is (5 + 3) × 2?", "choices": ["16", "13", "10", "18"], "answerIndex": 0, "explanation": "Do the parentheses first: 5 + 3 = 8, then multiply: 8 × 2 = 16." },
    { "id": "hsp-g5-08", "grade": 5, "strand": "fractions-decimals", "topic": "fraction-operations", "difficulty": 3, "prompt": "3/4 divided by 1/2 = ?", "choices": ["1 1/2", "3/8", "1/2", "2/3"], "answerIndex": 0, "explanation": "Dividing by 1/2 is the same as multiplying by 2: 3/4 × 2 = 6/4 = 1 1/2." },
    { "id": "hsp-g5-09", "grade": 5, "strand": "fractions-decimals", "topic": "fraction-operations", "difficulty": 2, "prompt": "A recipe needs 2/3 cup of sugar. If you triple the recipe, how much sugar do you need?", "choices": ["2 cups", "1 cup", "3 cups", "2/3 cup"], "answerIndex": 0, "explanation": "2/3 × 3 = 6/3 = 2 cups." },
    { "id": "hsp-g5-10", "grade": 5, "strand": "fractions-decimals", "topic": "decimal-operations", "difficulty": 2, "prompt": "A book costs $12.50 and a pen costs $2.75. What is the total cost?", "choices": ["$15.25", "$14.25", "$15.75", "$10.25"], "answerIndex": 0, "explanation": "$12.50 + $2.75 = $15.25." },
    { "id": "hsp-g5-11", "grade": 5, "strand": "number-sense", "topic": "factors-multiples", "difficulty": 2, "prompt": "Which of these is a common multiple of 4 and 6?", "choices": ["8", "10", "12", "14"], "answerIndex": 2, "explanation": "12 ÷ 4 = 3 and 12 ÷ 6 = 2, so 12 is a multiple of both." },
    { "id": "hsp-g5-12", "grade": 5, "strand": "operations", "topic": "order-of-operations", "difficulty": 2, "prompt": "What is 10 − 2 × 3?", "choices": ["4", "24", "8", "6"], "answerIndex": 0, "explanation": "Multiply first: 2 × 3 = 6, then subtract: 10 − 6 = 4." },

    { "id": "hsp-g6-01", "grade": 6, "strand": "data-ratios", "topic": "ratios-percentages", "difficulty": 2, "prompt": "A class has 12 boys and 18 girls. What is the ratio of boys to girls, in simplest form?", "choices": ["2:3", "3:2", "12:18", "6:9"], "answerIndex": 0, "explanation": "Both 12 and 18 can be divided by 6, giving 2:3." },
    { "id": "hsp-g6-02", "grade": 6, "strand": "data-ratios", "topic": "ratios-percentages", "difficulty": 2, "prompt": "What is 25% of 80?", "choices": ["20", "25", "16", "32"], "answerIndex": 0, "explanation": "25% is one quarter, and 80 ÷ 4 = 20." },
    { "id": "hsp-g6-03", "grade": 6, "strand": "data-ratios", "topic": "ratios-percentages", "difficulty": 2, "prompt": "What is 10% of 150?", "choices": ["15", "10", "1.5", "150"], "answerIndex": 0, "explanation": "10% means one tenth, and 150 ÷ 10 = 15." },
    { "id": "hsp-g6-04", "grade": 6, "strand": "number-sense", "topic": "negative-numbers", "difficulty": 2, "prompt": "What is −5 + 8?", "choices": ["3", "-3", "13", "-13"], "answerIndex": 0, "explanation": "Starting at −5 and moving up 8 lands on 3." },
    { "id": "hsp-g6-05", "grade": 6, "strand": "number-sense", "topic": "negative-numbers", "difficulty": 2, "prompt": "Which number is smaller: −3 or −7?", "choices": ["-3", "-7", "They are equal", "Cannot tell"], "answerIndex": 1, "explanation": "On a number line, −7 is further to the left, so it's smaller." },
    { "id": "hsp-g6-06", "grade": 6, "strand": "number-sense", "topic": "exponents", "difficulty": 2, "prompt": "What is 3² (3 to the power of 2)?", "choices": ["6", "9", "3", "12"], "answerIndex": 1, "explanation": "3² means 3 × 3 = 9." },
    { "id": "hsp-g6-07", "grade": 6, "strand": "number-sense", "topic": "exponents", "difficulty": 2, "prompt": "What is 2³ (2 to the power of 3)?", "choices": ["6", "8", "9", "16"], "answerIndex": 1, "explanation": "2³ means 2 × 2 × 2 = 8." },
    { "id": "hsp-g6-08", "grade": 6, "strand": "data-ratios", "topic": "statistics", "difficulty": 2, "prompt": "Find the mean (average) of these numbers: 4, 6, 8, 10.", "choices": ["6", "7", "8", "9"], "answerIndex": 1, "explanation": "Add them up: 4+6+8+10 = 28, then divide by 4 numbers: 28 ÷ 4 = 7." },
    { "id": "hsp-g6-09", "grade": 6, "strand": "data-ratios", "topic": "statistics", "difficulty": 2, "prompt": "Find the median (middle number) of these numbers: 3, 7, 9, 12, 15.", "choices": ["7", "9", "12", "15"], "answerIndex": 1, "explanation": "Once the numbers are in order, the middle one is 9." },
    { "id": "hsp-g6-10", "grade": 6, "strand": "geometry-measurement", "topic": "composite-area", "difficulty": 3, "prompt": "A shape is a 4 cm by 3 cm rectangle with a 2 cm by 2 cm square cut out of one corner. What is the remaining area?", "choices": ["8 cm²", "10 cm²", "6 cm²", "12 cm²"], "answerIndex": 0, "explanation": "The rectangle's area is 4×3=12 cm², minus the cut-out square's area of 2×2=4 cm², leaves 8 cm²." },
    { "id": "hsp-g6-11", "grade": 6, "strand": "data-ratios", "topic": "ratios-percentages", "difficulty": 2, "prompt": "A recipe uses a ratio of 2 cups of flour to 1 cup of sugar. If you use 6 cups of flour, how much sugar do you need?", "choices": ["3 cups", "2 cups", "4 cups", "6 cups"], "answerIndex": 0, "explanation": "6 cups of flour is 3 times as much as 2, so you need 3 times as much sugar: 3 cups." },
    { "id": "hsp-g6-12", "grade": 6, "strand": "data-ratios", "topic": "ratios-percentages", "difficulty": 2, "prompt": "A shirt that costs $40 is on sale for 25% off. How much do you save?", "choices": ["$10", "$30", "$25", "$15"], "answerIndex": 0, "explanation": "25% of $40 is a quarter of $40, which is $10." }
  ]
}
